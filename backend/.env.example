# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_interface

# Redis Configuration
REDIS_URL=redis://localhost:6379

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORGANIZATION=your-openai-org-id
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60000

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120000

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Azure OpenAI Configuration (Optional)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2023-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Execution Configuration
EXECUTION_TIMEOUT=300000
MAX_CONCURRENT_EXECUTIONS=10
CACHE_TIMEOUT=3600

# External Services Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@llm-interface.com

SLACK_BOT_TOKEN=your-slack-bot-token

# Feature Flags
ENABLE_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false
ENABLE_PUBLIC_WORKFLOWS=true
ENABLE_TEMPLATES=true
ENABLE_FILE_UPLOAD=true
ENABLE_CHAT=true
ENABLE_COLLABORATION=false
ENABLE_RECOMPUTATION=true

# Re-computation Configuration
MAX_CONCURRENT_RECOMPUTATION_PLANS=5
RECOMPUTATION_BATCH_SIZE=20
RECOMPUTATION_TIMEOUT=600000
RECOMPUTATION_RETRY_ATTEMPTS=3
RECOMPUTATION_RETRY_DELAY=1000
ENABLE_RECOMPUTATION_AUTO_RETRY=true
ENABLE_SMART_CACHING=true
ENABLE_PARALLEL_RECOMPUTATION=true
RECOMPUTATION_PRIORITY_QUEUE_SIZE=100
RECOMPUTATION_PROGRESS_INTERVAL=1000
COST_ESTIMATION_CACHE_TTL=300

# LLM Service Configuration (Additional)
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-3.5-turbo
LLM_MAX_CONCURRENT_REQUESTS=10
LLM_REQUEST_TIMEOUT=120000
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_DELAY=1000
LLM_ENABLE_CACHING=true
LLM_CACHE_TTL=3600
LLM_ENABLE_RATE_LIMITING=true
LLM_ENABLE_COST_TRACKING=true