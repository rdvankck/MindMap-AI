// PostgreSQL schema for LLM Interface
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflows     Workflow[]
  conversations Conversation[]
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  data        Json?
  status      String   @default("draft")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)

  user  User   @relation(fields: [userId], references: [id])
  nodes Node[]
  edges Edge[]
}

model Node {
  id         String   @id @default(uuid())
  workflowId String
  type       String
  data       Json
  position   Json
  status     String   @default("idle")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workflow  Workflow @relation(fields: [workflowId], references: [id])
  fromEdges Edge[]   @relation("fromEdges")
  toEdges   Edge[]   @relation("toEdges")
}

model Edge {
  id         String   @id @default(uuid())
  workflowId String
  sourceId   String
  targetId   String
  type       String   @default("default")
  data       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sourceNode Node     @relation("fromEdges", fields: [sourceId], references: [id])
  targetNode Node     @relation("toEdges", fields: [targetId], references: [id])
  workflow   Workflow @relation(fields: [workflowId], references: [id])
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  data      Json?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id])
  branches ConversationBranch[]
}

model ConversationBranch {
  id             String   @id @default(uuid())
  conversationId String
  name           String
  parentId       String?
  data           Json?
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation  Conversation         @relation(fields: [conversationId], references: [id])
  parentBranch  ConversationBranch?  @relation("ParentBranch", fields: [parentId], references: [id])
  childBranches ConversationBranch[] @relation("ParentBranch")
}
